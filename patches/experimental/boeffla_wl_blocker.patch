@@ -0,0 +1,23 @@
+/*
+ * Author: andip71, 01.09.2017
+ *
+ * Version 1.1.0
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ */
+
+#define BOEFFLA_WL_BLOCKER_VERSION	"1.1.0"
+
+#define LIST_WL_DEFAULT                 ""
+
+#define LENGTH_LIST_WL			1024
+#define LENGTH_LIST_WL_DEFAULT		1024
+#define LENGTH_LIST_WL_SEARCH		LENGTH_LIST_WL + LENGTH_LIST_WL_DEFAULT + 5
diff --git a/drivers/base/power/wakeup.c b/drivers/base/power/wakeup.c
index c010c03b9..4e2fefcd7 100644
--- a/drivers/base/power/wakeup.c
+++ b/drivers/base/power/wakeup.c
@@ -586,8 +586,59 @@ static void wakeup_source_activate(struct wakeup_source *ws)
  * @ws: Wakeup source to report the event for.
  * @hard: If set, abort suspends in progress and wake up from suspend-to-idle.
  */
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+#include "boeffla_wl_blocker.h"
+
+bool wl_blocker_active = false;
+bool wl_blocker_debug = false;
+extern char list_wl_search[LENGTH_LIST_WL_SEARCH];
+
+// AP: Function to check if a wakelock is on the wakelock blocker list
+static bool check_for_block(struct wakeup_source *ws)
+{
+	char wakelock_name[52] = {0};
+	int length;
+
+	if (wl_blocker_debug)
+		printk("Boeffla WL blocker: %s requested\n", ws->name);
+
+	if (!wl_blocker_active)
+		return false;
+
+	if (ws)
+	{
+		length = strlen(ws->name);
+		if ((length > 50) || (length < 1))
+			return false;
+
+		sprintf(wakelock_name, ";%s;", ws->name);
+
+		if (strstr(list_wl_search, wakelock_name) == NULL)
+			return false;
+
+		if (wl_blocker_debug)
+			printk("Boeffla WL blocker: %s blocked\n", ws->name);
+
+		if (ws->active)
+		{
+			wakeup_source_deactivate(ws);
+
+			if (wl_blocker_debug)
+				printk("Boeffla WL blocker: %s killed\n", ws->name);
+		}
+
+		return true;
+	}
+
+	return false;
+}
+#endif
+
 static void wakeup_source_report_event(struct wakeup_source *ws, bool hard)
 {
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+	if (!check_for_block(ws)) {
+#endif
 	ws->event_count++;
 	/* This is racy, but the counter is approximate anyway. */
 	if (events_check_enabled)
@@ -595,6 +646,9 @@ static void wakeup_source_report_event(struct wakeup_source *ws, bool hard)
 
 	if (!ws->active)
 		wakeup_source_activate(ws);
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+	}
+#endif
 
 	if (hard)
 		pm_system_wakeup();
diff --git a/kernel/power/Kconfig b/kernel/power/Kconfig
index afce8130d..194cfacdf 100644
--- a/kernel/power/Kconfig
+++ b/kernel/power/Kconfig
@@ -372,3 +372,14 @@ config ENERGY_MODEL
 	  The exact usage of the energy model is subsystem-dependent.
 
 	  If in doubt, say N.
+
+config BOEFFLA_WL_BLOCKER
+	bool "Boeffla wakelock blocker"
+	depends on PM_SLEEP
+	default n
+	help
+	  Kernel-level wakelock blocker with a sysfs interface, to cut idle
+	  battery drain by suppressing chosen wakeup sources by name via
+	  /sys/devices/virtual/misc/boeffla_wakelock_blocker/wakelock_blocker.
+	  The block list is EMPTY by default, so enabling this changes nothing
+	  until user space adds wakelock names.
